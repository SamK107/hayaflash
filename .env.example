# =============================================================================
# HayaFlash — environment template
# Copy to ".env" (never commit ".env"). See project README / docs for prod.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Logical label: dev | staging | prod (legacy alias: ENV)
ENVIRONMENT=dev
# Optional legacy key (used only if ENVIRONMENT is unset):
# ENV=dev

# Django settings module (loaded early in manage.py / WSGI / ASGI via dotenv):
#   config.settings.dev     — SQLite db_dev.sqlite3, DEBUG on
#   config.settings.staging — PostgreSQL, DEBUG off
#   config.settings.prod    — PostgreSQL, DEBUG off, strict security
DJANGO_SETTINGS_MODULE=config.settings.dev

# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------
# Production / staging: required, strong random string.
# Dev: optional; ephemeral key is generated if empty (see dev settings warning).
SECRET_KEY=
# Parsed in base first; dev module forces DEBUG=True. Never use DEBUG=true with
# ENVIRONMENT=prod (base will refuse to start).
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Cache / Redis (optional in dev; recommended staging/prod for OTP + multi-worker)
# -----------------------------------------------------------------------------
# If set, default cache uses Redis (django-redis). If unset, LocMemCache is used.
# REDIS_URL=redis://127.0.0.1:6379/1

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# If set (non-empty), DATABASE_URL wins over DB_* (dj-database-url).
# Staging/prod must resolve to PostgreSQL (postgres:// or postgresql://).
# Leave unset or empty to use SQLite (dev) or DB_* (staging/prod).
# Example: postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=

# SQLite file name under project root when ENVIRONMENT=dev and DATABASE_URL is unset.
# DEV_SQLITE_NAME=db_dev.sqlite3

# PostgreSQL via discrete variables (required for staging/prod when DATABASE_URL is unset).
DB_NAME=hayaflash
DB_USER=hayaflash
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# -----------------------------------------------------------------------------
# Static & media (optional overrides; safe defaults exist in settings)
# -----------------------------------------------------------------------------
# STATIC_URL=static/
# STATIC_ROOT=
# MEDIA_URL=media/
# MEDIA_ROOT=

# Public base URL for share links / WhatsApp (optional; dev uses request host).
# HAYAFLASH_PUBLIC_BASE_URL=https://app.example.com

# -----------------------------------------------------------------------------
# Security (production / staging; dev may leave CORS empty)
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=true
CSRF_TRUSTED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Payments / Mobile Money webhooks (staging/prod: set strong secrets)
# -----------------------------------------------------------------------------
# HMAC SHA256 over raw webhook JSON body; header: X-Payment-Signature: sha256=<hex>
# PAYMENTS_WEBHOOK_SECRET=
# Force mock provider to fail immediately (testing).
# PAYMENTS_MOCK_SIMULATE_FAILURE=false

# -----------------------------------------------------------------------------
# Email (optional)
# -----------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@example.com
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true

# -----------------------------------------------------------------------------
# SMS — Orange Mali API (notifications commandes)
# -----------------------------------------------------------------------------
# ORANGE_SMS_API_KEY=
# ORANGE_SMS_BASE_URL=https://api.orange.com/smsmessaging/v1

# -----------------------------------------------------------------------------
# Sentry (prod + staging, opt-in — monitoring erreurs)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Staging : definir aussi SENTRY_DSN pour avoir de la visibilite (etiquete
# environment="staging"). Sans DSN, Sentry reste desactive.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.05

# -----------------------------------------------------------------------------
# Docker / CI — Image et domaine de production
# -----------------------------------------------------------------------------
# Image et tag Docker à déployer (utilisé par docker-compose.production.yml).
# En CI/CD (.github/workflows/deploy.yml + infra/scripts/deploy.sh), ces deux
# variables sont injectées automatiquement — DOCKER_IMAGE pointe vers GHCR et
# IMAGE_TAG = SHA du commit. Ne pas les fixer ici en prod (le script les passe
# à chaque déploiement) ; utile seulement en dev/debug local du compose file.
# DOCKER_IMAGE=ghcr.io/<org>/hayaflash
# IMAGE_TAG=latest

# Domaine public (utilisé par Nginx prod.conf et smoke_test.sh)
# PROD_DOMAIN=app.hayaflash.com

# -----------------------------------------------------------------------------
# GHCR sur le VPS — requis une seule fois si le package est privé
# -----------------------------------------------------------------------------
# `docker compose pull` sur le VPS doit s'authentifier pour tirer une image
# privée de ghcr.io. À faire une fois manuellement sur chaque hôte (staging
# et prod), PAS via ce fichier .env :
#   echo "<PAT avec scope read:packages>" | docker login ghcr.io -u <user> --password-stdin
# Alternative : rendre le package GHCR public (Settings → Package → Visibility).

# Mot de passe Redis en production (optionnel, recommandé)
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Celery (override optionnel — par défaut REDIS_URL)
# -----------------------------------------------------------------------------
# CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
# CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Orange Money Paiement abonnements (Phase 8.1) ──────────────────────────────
# Intégration WebPay pour upgrades de plans FREE → MEDIUM/PRO.
# Voir CLAUDE.md § Orange Money Payment Integration pour l'architecture.

# OAuth2 Credentials (obtenir sur https://developer.orange.com/ espace Mali)
# Client ID pour grant_type=client_credentials
ORANGE_ML_CLIENT_ID=

# Client Secret (garder secret, jamais committer)
ORANGE_ML_CLIENT_SECRET=

# Merchant Key fourni par Orange Money
ORANGE_ML_MERCHANT_KEY=

# Base URL publique pour les redirections / callbacks (HTTPS obligatoire, jamais localhost)
# Dev  : utilisez ngrok  →  ORANGE_ML_BASE_URL=https://xxxx.ngrok-free.app
#        (puis relancer : python manage.py runserver, webhook sera sur https://xxxx.ngrok-free.app/billing/webhook/orange/)
# Prod : ORANGE_ML_BASE_URL=https://app.hayaflash.com
ORANGE_ML_BASE_URL=

# URLs fixes des endpoints de paiement (optionnel)
# Si non configurées, elles sont générées automatiquement à partir de ORANGE_ML_BASE_URL
# ORANGE_ML_RETURN_URL=https://app.example.com/billing/return/
# ORANGE_ML_CANCEL_URL=https://app.example.com/billing/cancel/
# ORANGE_ML_NOTIFY_URL=https://app.example.com/billing/webhook/orange/

# Timeout pour appels Orange Money API (secondes)
# ORANGE_ML_TIMEOUT=20

# Devise de paiement (XOF pour Mali)
# ORANGE_ML_CURRENCY=XOF

# Version du code (ex. SHA git), incluse dans les ETag des pages publiques pour
# invalider le cache navigateur a chaque deploiement. Vide = heure de demarrage.
APP_RELEASE=
