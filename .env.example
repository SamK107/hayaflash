# =============================================================================
# HayaFlash — environment template
# Copy to ".env" (never commit ".env"). See project README / docs for prod.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Logical label: dev | staging | prod (legacy alias: ENV)
ENVIRONMENT=dev
# Optional legacy key (used only if ENVIRONMENT is unset):
# ENV=dev

# Django settings module (loaded early in manage.py / WSGI / ASGI via dotenv):
#   config.settings.dev     — SQLite db_dev.sqlite3, DEBUG on
#   config.settings.staging — PostgreSQL, DEBUG off
#   config.settings.prod    — PostgreSQL, DEBUG off, strict security
DJANGO_SETTINGS_MODULE=config.settings.dev

# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------
# Production / staging: required, strong random string.
# Dev: optional; ephemeral key is generated if empty (see dev settings warning).
SECRET_KEY=
# Parsed in base first; dev module forces DEBUG=True. Never use DEBUG=true with
# ENVIRONMENT=prod (base will refuse to start).
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Cache / Redis (optional in dev; recommended staging/prod for OTP + multi-worker)
# -----------------------------------------------------------------------------
# If set, default cache uses Redis (django-redis). If unset, LocMemCache is used.
# REDIS_URL=redis://127.0.0.1:6379/1

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# If set (non-empty), DATABASE_URL wins over DB_* (dj-database-url).
# Staging/prod must resolve to PostgreSQL (postgres:// or postgresql://).
# Leave unset or empty to use SQLite (dev) or DB_* (staging/prod).
# Example: postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=

# SQLite file name under project root when ENVIRONMENT=dev and DATABASE_URL is unset.
# DEV_SQLITE_NAME=db_dev.sqlite3

# PostgreSQL via discrete variables (required for staging/prod when DATABASE_URL is unset).
DB_NAME=hayaflash
DB_USER=hayaflash
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# -----------------------------------------------------------------------------
# Static & media (optional overrides; safe defaults exist in settings)
# -----------------------------------------------------------------------------
# STATIC_URL=static/
# STATIC_ROOT=
# MEDIA_URL=media/
# MEDIA_ROOT=

# Public base URL for share links / WhatsApp (optional; dev uses request host).
# HAYAFLASH_PUBLIC_BASE_URL=https://app.example.com

# -----------------------------------------------------------------------------
# Security (production / staging; dev may leave CORS empty)
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=true
CSRF_TRUSTED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Payments / Mobile Money webhooks (staging/prod: set strong secrets)
# -----------------------------------------------------------------------------
# HMAC SHA256 over raw webhook JSON body; header: X-Payment-Signature: sha256=<hex>
# PAYMENTS_WEBHOOK_SECRET=
# Force mock provider to fail immediately (testing).
# PAYMENTS_MOCK_SIMULATE_FAILURE=false

# -----------------------------------------------------------------------------
# E-mail (SMTP) — console en dev, SMTP LWS au lancement (staging/prod)
# -----------------------------------------------------------------------------
# Sans EMAIL_BACKEND : les e-mails s'affichent dans la console (dev, tests).
# Staging/prod : SMTP LWS. Le mot de passe va UNIQUEMENT dans le .env du serveur.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.hayaflash.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=true            # port 465 = SSL implicite
# EMAIL_USE_TLS=false           # exclusif avec EMAIL_USE_SSL (587 = STARTTLS : TLS=true, SSL=false)
# EMAIL_HOST_USER=contact@hayaflash.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=contact@hayaflash.com
# SERVER_EMAIL=contact@hayaflash.com   # expediteur des e-mails d'erreur Django
# EMAIL_TIMEOUT=15
# Test : docker compose exec web python manage.py send_test_email vous@example.com

# -----------------------------------------------------------------------------
# SMS — Orange Mali API (INACTIF au lancement, decision D3 du 18/10)
# -----------------------------------------------------------------------------
# Aucun SMS n'est envoye tant que SMS_NOTIFICATIONS_ENABLED n'est pas "true" ET que les
# cles ci-dessous ne sont pas renseignees. Ne pas l'activer sans revoir les textes
# publics (« M'alerter » promet WhatsApp) et la politique de confidentialite.
# SMS_NOTIFICATIONS_ENABLED=false
# ORANGE_SMS_API_KEY=
# ORANGE_SMS_BASE_URL=https://api.orange.com/smsmessaging/v1

# -----------------------------------------------------------------------------
# Sentry (prod + staging, opt-in — monitoring erreurs)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Staging : definir aussi SENTRY_DSN pour avoir de la visibilite (etiquete
# environment="staging"). Sans DSN, Sentry reste desactive.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.05

# -----------------------------------------------------------------------------
# Content-Security-Policy (config/settings/_csp.py)
# -----------------------------------------------------------------------------
# Endpoint "security" Sentry (Project Settings > Security Headers) : les
# violations CSP y remontent. Vide = pas de report-uri.
# CSP_REPORT_URI=https://o<org>.ingest.sentry.io/api/<project>/security/?sentry_key=<key>
# Report-Only par defaut (true). false = mode bloquant : a reserver a un test
# local ou a l'etape 6 du runbook (docs/RUNBOOK_JOUR_J.md), jamais par defaut.
# CSP_REPORT_ONLY=true

# -----------------------------------------------------------------------------
# Healthcheck Celery (/health/, check "celery")
# -----------------------------------------------------------------------------
# Age max (s) du dernier battement core.celery_heartbeat avant "stale".
# HEALTH_CELERY_MAX_AGE=180
# true = /health/ en 503 si Celery est stale/missing. Laisser false tant que
# le HEALTHCHECK Docker / smoke_test.sh s'appuient sur /health/ (sinon rollback
# au demarrage, avant le 1er battement). Voir config/settings/base.py.
# HEALTH_CELERY_REQUIRED=false

# -----------------------------------------------------------------------------
# Piles Docker (staging et prod sur le meme VPS) — PP-04
# -----------------------------------------------------------------------------
# Ces variables doivent se trouver dans le .env A COTE de docker-compose.production.yml
# (un clone par pile : /srv/hayaflash = staging, /srv/hayaflash-prod = prod). Compose
# lit ce .env pour l'interpolation (nom de projet, port, image) et le passe aux
# conteneurs. Les valeurs par defaut = le staging : ne rien poser pour lui.
# Les volumes et le reseau prennent le nom du projet (hayaflash_postgres_data...).
# Controle : bash infra/scripts/check_stack_isolation.sh <dossier_pile>
#
#                        staging (defaut)   production
# HAYAFLASH_PROJECT      hayaflash          hayaflash-prod
# HAYAFLASH_HTTP_PORT    8020               8021
# DOCKER_IMAGE           hayaflash          hayaflash-prod
# IMAGE_TAG              latest             latest
#
# HAYAFLASH_PROJECT=hayaflash-prod
# HAYAFLASH_HTTP_PORT=8021
# DOCKER_IMAGE=hayaflash-prod
# IMAGE_TAG=latest
# (Ancien flux CI/CD GHCR : DOCKER_IMAGE=ghcr.io/<org>/hayaflash, IMAGE_TAG=<sha>.)

# Donnees de demo (boutiques du Marche) — staging uniquement — JAMAIS en production.
# prod.py refuse de demarrer si cette variable vaut 1 et que ALLOWED_HOSTS contient
# hayaflash.com, www.hayaflash.com, .hayaflash.com ou * (message « Variable de démo
# interdite en production »). Absente de la prod, tout simplement.
# HAYAFLASH_ALLOW_DEMO_SEED=1

# -----------------------------------------------------------------------------
# Sauvegardes (infra/scripts/backup.sh) — optionnel, voir docs/SAUVEGARDES.md
# -----------------------------------------------------------------------------
# BACKUP_ROOT=/srv/backups/hayaflash-prod   # defaut : /srv/backups/<projet>
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
# BACKUP_REMOTE=                             # vide = locale seulement (copie rclone si renseigne)

# Domaine public (utilisé par Nginx prod.conf et smoke_test.sh)
# PROD_DOMAIN=hayaflash.com   # staging : son propre domaine

# -----------------------------------------------------------------------------
# GHCR sur le VPS — requis une seule fois si le package est privé
# -----------------------------------------------------------------------------
# `docker compose pull` sur le VPS doit s'authentifier pour tirer une image
# privée de ghcr.io. À faire une fois manuellement sur chaque hôte (staging
# et prod), PAS via ce fichier .env :
#   echo "<PAT avec scope read:packages>" | docker login ghcr.io -u <user> --password-stdin
# Alternative : rendre le package GHCR public (Settings → Package → Visibility).

# Mot de passe Redis en production (optionnel, recommandé)
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Celery (override optionnel — par défaut REDIS_URL)
# -----------------------------------------------------------------------------
# CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
# CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Orange Money Paiement abonnements (Phase 8.1) ──────────────────────────────
# Intégration WebPay pour upgrades de plans FREE → MEDIUM/PRO.
# Voir CLAUDE.md § Orange Money Payment Integration pour l'architecture.

# Chaque variable ORANGE_ML_* peut aussi s'ecrire ORANGE_MONEY_* (meme suffixe) ; si les deux
# existent, ORANGE_ML_* l'emporte. Le timeout (1 a 120 s, defaut 20) et la devise (defaut XOF)
# suivent la meme regle.

# OAuth2 Credentials (obtenir sur https://developer.orange.com/ espace Mali)
# Client ID pour grant_type=client_credentials
ORANGE_ML_CLIENT_ID=

# Client Secret (garder secret, jamais committer)
ORANGE_ML_CLIENT_SECRET=

# Merchant Key fourni par Orange Money
ORANGE_ML_MERCHANT_KEY=

# Base URL publique pour les redirections / callbacks (HTTPS obligatoire, jamais localhost)
# Dev  : utilisez ngrok  →  ORANGE_ML_BASE_URL=https://xxxx.ngrok-free.app
#        (puis relancer : python manage.py runserver, webhook sera sur https://xxxx.ngrok-free.app/billing/webhook/orange/)
# Prod : ORANGE_ML_BASE_URL=https://hayaflash.com
ORANGE_ML_BASE_URL=

# URLs fixes des endpoints de paiement (optionnel)
# Si non configurées, elles sont générées automatiquement à partir de ORANGE_ML_BASE_URL
# ORANGE_ML_RETURN_URL=https://app.example.com/billing/return/
# ORANGE_ML_CANCEL_URL=https://app.example.com/billing/cancel/
# ORANGE_ML_NOTIFY_URL=https://app.example.com/billing/webhook/orange/

# Timeout pour appels Orange Money API (secondes)
# ORANGE_ML_TIMEOUT=20  (1 a 120)

# Devise de paiement (XOF pour Mali)
# ORANGE_ML_CURRENCY=XOF

# Version du code (ex. SHA git), incluse dans les ETag des pages publiques pour
# invalider le cache navigateur a chaque deploiement. Vide = heure de demarrage.
APP_RELEASE=

# Identite de l'editeur pour les documents du programme partenaires (ne jamais inventer
# de valeur ; vide = document « incomplet », acceptation refusee hors dev)
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_FORM=
# Facultatif (entreprise individuelle) : exclu de la completude, omis des textes s'il est vide
LEGAL_ENTITY_CAPITAL=
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_RCCM=
LEGAL_ENTITY_CONTACT=
LEGAL_JURISDICTION=
# Hebergeur affiche dans les mentions legales (vide = mention generique)
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_PHONE=

# -----------------------------------------------------------------------------
# Hotes et proxy (D8, D14, F-26) — voir docs/RUNBOOK_JOUR_J.md etape 5 ter / 5b
# -----------------------------------------------------------------------------
# Prod : ALLOWED_HOSTS=hayaflash.com,www.hayaflash.com,localhost  (localhost = healthcheck)
# www est redirige en 301 vers hayaflash.com. Staging : tout hote non production est
# automatiquement non indexable (robots.txt + X-Robots-Tag) ; ne PAS definir HAYAFLASH_NOINDEX=1
# avec un hote de production (refus de demarrer).
# IP(s) de confiance du Nginx du conteneur (real_ip) ; defaut = plages bridge Docker.
# HF_REAL_IP_FROM=172.16.0.0/12

# Prix barre + « Prix promo » sur les pages clientes (defaut : true).
# false = seul le prix applique est affiche (le prix facture ne change pas).
HAYAFLASH_PROMO_DISPLAY=true

# Module Distrib (grossistes / revendeurs). Defaut : false = URLs /distrib/ en 404,
# bandeau absent. Activer seulement apres la procedure de SPEC_03 §12.
DISTRIB_ENABLED=false
