# infra/cron/hayaflash-backup — crontab de l'utilisateur « sam » (PAS /etc/cron.d).
#
# Sauvegarde quotidienne de la PRODUCTION a 03:17 UTC (heure creuse ; = 03:17 a
# Bamako). Pas de cron pour le staging. Installation SANS ecraser la crontab
# existante (idempotente : remplace seulement la ligne marquee # hayaflash-prod-backup) :
#
#   ( crontab -l 2>/dev/null | grep -v '# hayaflash-prod-backup' ; \
#     echo "17 3 * * * cd /srv/hayaflash-prod && bash infra/scripts/backup.sh /srv/hayaflash-prod >> /srv/backups/hayaflash-prod/cron.log 2>&1 # hayaflash-prod-backup" ) | crontab -
#
# Verifier : crontab -l   |   Resultat : tail /srv/backups/hayaflash-prod/backup.log
# Prerequis : sudo install -d -o sam -m 700 /srv/backups /srv/backups/hayaflash-prod
#
# Ligne installee :
17 3 * * * cd /srv/hayaflash-prod && bash infra/scripts/backup.sh /srv/hayaflash-prod >> /srv/backups/hayaflash-prod/cron.log 2>&1 # hayaflash-prod-backup
